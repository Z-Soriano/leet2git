{
  "manifest_version": 3,
  "name": "leet2git",
  "version": "0.1.0",
  "description": "Save Accepted LeetCode submissions to your GitHub repository.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "leet2git settings", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["page-listener.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
